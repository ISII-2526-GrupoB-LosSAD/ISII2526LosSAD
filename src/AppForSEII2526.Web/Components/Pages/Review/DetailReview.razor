@page "/review/detailreview"

@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@inject AppForDevicesAPIClient apiclient

<h3>DetailReview</h3>


@if (review==null)
{
    <p>@error</p>
}else
{
        <table class="table table-borderless table-sm">
        <tr>
            <th>Name</th>
            <td id="NameSurname">@review.CustomerUserName</td>
        </tr>
        <tr>
            <th>Country</th>
            <td id="Country">@review.Country</td>
        </tr>
        <tr>
            <th>Review Title</th>
            <td id="Review Title">@review.ReviewTitle</td>
        </tr>
        <tr>
            <th>Rental Date</th>
            <td id="RentalDate">@review.DateOfReview.ToString("dd/MM/yyyy hh:mm:ss")</td>
        </tr>
    </table>

       <h4>Reviewd Devices</h4>

    <table class="table" id="ReviewdDevices">
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Model</th>
                <th scope="col">Year</th>
                <th scope="col">Rating</th>
                <th scope="col">Comments</th>
            </tr>
        </thead>
        <tbody>
            @foreach (ReviewItemDTO item in review.ReviewItems)
            {
                <tr id="RentalItem_@item.Name">
                    <td>@item.Name</td>
                    <td>@item.Model</td>
                    <td>@item.Year</td>
                    <td>@item.Rating</td>
                    <td>@item.Comments</td>
                </tr>
            }
        </tbody>

    </table>

}

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int ReviewID { get; set; }
    private ReviewDetailDTO review;
    private string error = "";




    protected override async Task OnInitializedAsync() {

        

        try {
            review = await apiclient.GetReviewAsync(ReviewID);
        }
        catch (ApiException exception) {
            review = null;
        }
        if ((review == null)) {
            error = $"Error! You are not authorized to see this rental or there is not a review with id={ReviewID}";
        }


    }

}
