@page "/receipt/createReceipt"

@inject NavigationManager navigation
@using AppForSEII2526.Web.Components.Shared
@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@inject AppForDevicesAPIClient apiclient
@inject ILogger<CreateReceipt> logger
@inject ReceiptStateContainer receiptState

<h3>Create Receipt</h3>

<EditForm Model="receipt" OnValidSubmit="OpenDialog">
    <div class="row">
        <DataAnnotationsValidator />
        <ValidationSummary class="row alert alert-danger" />
    </div>
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @messageError</p>
    </div>
    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="receipt.CustomerUserName" class="form-control" id="Name" />
                <label for="Name">Name </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="receipt.CustomerUserSurname" class="form-control" id="Surname" />
                <label for="Surname">Surname </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="receipt.DeliveryAddress" class="form-control" id="DeliveryAddress" />
                <label for="DeliveryAddress">Delivery Address</label>
            </div>
        </div>
    </div>

    <div class="row g-2">
        <div class="col-md">
            <div class="form-floating">
                @*a dropdown for selecting the payment method*@
                <InputSelect class="form-select" @bind-Value="@receipt.ReceiptPaymentMethodTypes" id="PaymentMethod">
                    <option value="@ReceiptPaymentMethodTypes.CreditCard" default> CreditCard</option>
                    <option value="@ReceiptPaymentMethodTypes.Paypal"> PayPal</option>
                    <option value="@ReceiptPaymentMethodTypes.BankTransfer"> BankTransfer</option>
                </InputSelect>
                <label for="PaymentMethod">Payment Method</label>
            </div>
        </div>

    <div class="col-md">
        <div class="form-floating">
            @*this button will be used to ask the user if he want to proceed to rent the movies*@
            <button class="btn btn-primary" type="submit" id="Submit">
                Receipt your repairs
            </button>
        </div>
    </div>
    </div>
    <h4>Receipt detail</h4>
    <p>
        <b>Total price:</b> @TotalCost €
        <button class="btn btn-outline-primary" type="button" @onclick="ModifyReceiptItems" id="ModifyRepairs">
            Modificar reparaciones
        </button>
    </p>

    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="TableOfReceiptItems">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Scale</th>
                    <th>Cost</th>
                    <th>Model</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in receipt.ReceiptItems)
                {
                    <tr id="RepairData_@item.Name">
                        <td>@item.Name</td>
                        <td>@item.Scale</td>
                        <td>@item.Cost</td>
                        <td><InputText @bind-Value="item.Model" class="form-control" id="@($"model_{item.RepairID}")" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</EditForm>

@if(DialogIsOpen)
{
    <Dialog Caption="Receipt repairs"
            Message="Do you want to proceed to receipt the selected repairs?"
            OnClose="@OnDialogClose"
            Type=Dialog.Category.SaveNot>
    </Dialog>
}

@code {
    private string messageError = "";
    private bool hideErrors { get { return messageError.Length == 0; } }
    private bool DialogIsOpen;

    private decimal TotalCost
    {
        get
        {
            // Protege contra nulls
            if (receipt?.ReceiptItems == null || receipt.ReceiptItems.Count == 0)
                return 0m;

            // ReceiptitemDTO.Cost es float, sumamos como double y convertimos a decimal
            float total = receipt.ReceiptItems.Sum(ri => (float)ri.Cost);
            return Convert.ToDecimal(total);
        }
    }

    private void ModifyReceiptItems()
    {
        // Navegar a la pantalla para seleccionar reparaciones
        navigation.NavigateTo("/receipt/selectrepairforreceipt");
    }

    private ReceiptForCreateDTO receipt => receiptState.Receipt;

    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {

        DialogIsOpen = false;
        if (isOk)
        {
            // Process the data introduced by the user if they are valid
            if (receipt.ReceiptItems.Count > 0)
            {
                try
                {
                    var receipted = await apiclient.CreateRepairAsync(receipt);
                    receiptState.ReceiptProcessed();
                    navigation.NavigateTo($"/receipt/detailreceipt/?ReceiptID={receipted.ReceiptId}");
                }
                catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
                {

                    if (apiexceptionvalidation.Result.Errors.Values != null)
                    {
                        messageError = "";
                        foreach (var errors in apiexceptionvalidation.Result.Errors.Values)
                            //https://learn.microsoft.com/en-us/dotnet/api/system.string.join?view=net-7.0
                            messageError = string.Join("(*) ", messageError, string.Join(" (*) ", errors));
                    }
                }

                catch (ApiException apiexception)
                {
                    //we need to inform user that there was some other error while processing the request
                    messageError = "Error while processing your request, please try again later!";

                }
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        
        
            //receipt.CustomerUserName = receipt.CustomerUserName == null ? "" : receipt.CustomerUserName;
            //receipt.CustomerUserSurname = receipt.CustomerUserSurname == null ? "" : receipt.CustomerUserSurname;
            //receipt.DeliveryAddress = receipt.DeliveryAddress == null ? "" : receipt.DeliveryAddress;

        
    }
    // [CascadingParameter]
    // private Task<AuthenticationState>? authenticationState { get; set; }

}
