@page "/device/createpurchase"

@inject NavigationManager navigation
@using AppForSEII2526.Web.Components.Shared
@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@inject AppForDevicesAPIClient apiclient
@inject ILogger<CreatePurchase> logger
@inject PurchaseStateContainer purchaseState



<h3>Create Purchase</h3>

@* purchase is the object that will be edited thanks to the form *@
<EditForm Model="purchase" OnValidSubmit="OpenDialog">
    <div class="row">
        <DataAnnotationsValidator />
        <ValidationSummary class="row alert alert-danger" />
    </div>

    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @messageError</p>
    </div>

    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="purchase.CustomerUserName" class="form-control" id="Name" />
                <label for="Name">Name </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="purchase.UserSurname" class="form-control" id="Surname" />
                <label for="Surname">Surname </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="purchase.DeliveryAddress" class="form-control" id="DeliveryAddress" />
                <label for="DeliveryAddress">Delivery Address</label>
            </div>
        </div>
    </div>

    <div class="row g-2">
        <div class="col-md">
            <div class="form-floating">
                @*a dropdown for selecting the payment method*@
                <InputSelect class="form-select" @bind-Value="@purchase.PaymentMethod" id="PaymentMethod">
                    <option value="@PurchasePaymentMethodTypes.CreditCard" default> CreditCard</option>
                    <option value="@PurchasePaymentMethodTypes.Paypal"> Paypal</option>
                </InputSelect>
                <label for="PaymentMethod">Payment Method</label>
            </div>
        </div>

        <div class="col-md">
            <div class="form-floating">
                @*this button will be used to ask the user if he want to proceed to purchase the devices*@
                <button class="btn btn-primary" type="submit" id="Submit">
                    Purchase your device
                </button>
            </div>
        </div>
    </div>

    <h4>Purchase detail</h4>
    <p><b>Date from:</b> @purchase.PurchaseDateFrom.ToString("dd/MM/yyyy") <b>to:</b> @purchase.PurchaseDateTo.ToString("dd/MM/yyyy")</p>
    <p>
        <b>Total price:</b> @TotalCost € |
        <b>Total quantity:</b> @TotalQuantity items
        <button class="btn btn-outline-primary" type="button" @onclick="ModifyPurchaseItems"
                id="ModifyDevices">
            Modify devices
        </button>
    </p>

    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="TableOfPurchaseItems">
            <thead>
                <tr>
                    <th>Model</th>
                    <th>Color</th>
                    <th>Brand</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in purchase.PurchaseItems)
                {
                    <tr id="DeviceData_@item.Model">
                        <td>@item.Model</td>
                        <td>@item.Color</td>
                        <td>@item.Brand</td>
                        <td><InputNumber @bind-Value="item.Quantity" class="form-control min="1" id="@($"quantity_{item.DeviceID}")" /></td>
                        <td>@item.Price</td>
                        <td><InputText @bind-Value="item.Description" class="form-control" id="@($"description_{item.DeviceID}")" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</EditForm>

@*a modal popup dialog for checking if user wants to proceed to purchase*@
@if (DialogIsOpen)
{
    <Dialog Caption="Purchase devices"
            Message="Do you want to proceed to purchase the selected devices?"
            OnClose="@OnDialogClose"
            Type=Dialog.Category.SaveNot>
    </Dialog>
}
@code {
    private PurchaseForCreateDTO purchase => purchaseState.Purchase;

    private string messageError = "";
    private bool hideErrors { get { return messageError.Length == 0; } }

    private bool DialogIsOpen;

    private decimal TotalCost
    {
        get
        {
            int days = (purchase.PurchaseDateTo.DateTime - purchase.PurchaseDateFrom.DateTime).Days;
            double price = purchase.PurchaseItems.Sum(ri => ri.Price * days);
            return Convert.ToDecimal(price);
        }
    }

    private int TotalQuantity
    {
        get
        {
            return purchase.PurchaseItems.Sum(ri => ri.Quantity);
        }
    }

    private void ModifyPurchaseItems()
    {
        navigation.NavigateTo("/purchase/selectDevicePurchase");
    }
    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    

    private async Task OnDialogClose(bool isOk)
    {

        DialogIsOpen = false;
        if (isOk)
        {
            // Process the data introduced by the user if they are valid
            if (purchase.PurchaseItems.Count > 0)
            {
                try
                {
                    var purchased = await apiclient.CreatePurchaseAsync(purchase);
                    purchaseState.PurchaseProcessed();
                    navigation.NavigateTo($"/device/detailpurchase/?PurchaseID={purchased.Id}");
                }
                catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
                {

                    if (apiexceptionvalidation.Result.Errors.Values != null)
                    {
                        messageError = "";
                        foreach (var errors in apiexceptionvalidation.Result.Errors.Values)
                            //https://learn.microsoft.com/en-us/dotnet/api/system.string.join?view=net-7.0
                            messageError = string.Join("(*) ", messageError, string.Join(" (*) ", errors));
                    }
                }

                catch (ApiException apiexception)
                {
                    //we need to inform user that there was some other error while processing the request
                    messageError = "Error while processing your request, please try again later!";

                }
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {


        purchase.CustomerUserName = purchase.CustomerUserName == null ? "" : purchase.CustomerUserName;
        purchase.UserSurname = purchase.UserSurname == null ? "" : purchase.UserSurname;
        purchase.DeliveryAddress = purchase.DeliveryAddress == null ? "" : purchase.DeliveryAddress;


    }
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

}